{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fur Agent: process_data.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\process_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${command:python.interpreterPath}",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Fur Agent: process_data.py (python type)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}\\process_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
