{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hole Pool: process_data.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/process_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
